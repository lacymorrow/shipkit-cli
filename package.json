{
  "name": "create-shipkit-app",
  "version": "0.4.2",
  "description": "Create a ShipKit app from Bones and keep it in sync with upstream",
  "type": "module",
  "bin": {
    "create-shipkit-app": "./dist/index.js",
    "shipkit": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "keywords": [
    "shipkit",
    "nextjs",
    "starter",
    "cli",
    "scaffold"
  ],
  "author": "Lacy Morrow",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacymorrow/shipkit-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lacymorrow/shipkit-cli/issues"
  },
  "homepage": "https://shipkit.io",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
